    "/api/v1/cart/items": {
      "post": {
        "tags": [
          "Cart"
        ],
        "summary": "Add item to shopping cart",
        "description": "Add a jewellery item to the specified shopping cart with quantity.",
        "operationId": "add_to_cart_v1_api_v1_cart_items_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddToCartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
