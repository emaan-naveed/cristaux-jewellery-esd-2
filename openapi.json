    "/admin/reset-limits": {
      "post": {
        "tags": [
          "Admin & Observability"
        ],
        "summary": "Reset in-memory rate limits & idempotency cache",
        "description": "Admin endpoint to reset rate limits and idempotency cache for test isolation.",
        "operationId": "reset_limits_admin_reset_limits_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
