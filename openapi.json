    "/admin/fault": {
      "post": {
        "tags": [
          "Admin & Observability"
        ],
        "summary": "Configure fault injection",
        "description": "Configure artificial delay, error rate, or specific status codes (e.g. 503).",
        "operationId": "set_fault_admin_fault_post",
