{
  "openapi": "3.1.0",
  "info": {
    "title": "Cristaux Jewellery Store API",
    "description": "Enterprise Luxury Jewellery RESTful E-Commerce API featuring Prometheus Metrics, Structured JSON Logging, OpenAPI 3.1 Spec, Rate Limiting, and Idempotency Protection.",
    "contact": {
      "name": "Cristaux Jewellery Engineering Team",
      "email": "api@cristaux-jewellery.com"
    },
    "version": "2.0.0"
  },
  "paths": {
    "/api/v1/products": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "List jewellery catalog",
        "description": "Retrieve all available jewellery items, optionally filtered by category.",
        "operationId": "get_products_v1_api_v1_products_get",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter products by category",
              "title": "Category"
            },
            "description": "Filter products by category"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
