  },
  "components": {
    "schemas": {
      "AddToCartRequest": {
        "properties": {
          "cart_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "title": "Cart Id",
            "description": "Unique cart session identifier"
          },
          "product_id": {
            "type": "string",
            "maxLength": 16,
            "minLength": 2,
            "title": "Product Id",
            "description": "Catalog product ID (e.g. p1, p2)"
          },
          "quantity": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Quantity",
            "description": "Quantity to add (1 to 20)",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "cart_id",
          "product_id"
        ],
        "title": "AddToCartRequest"
      },
      "FaultConfigRequest": {
        "properties": {
          "delay_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Delay Ms",
            "description": "Artificial latency delay in milliseconds",
            "default": 0.0
          },
          "error_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Error Rate",
            "description": "Probability of triggering errors (0.0 to 1.0)",
            "default": 0.0
          },
          "status_code": {
            "type": "integer",
            "title": "Status Code",
            "description": "HTTP status code to simulate (e.g. 503, 500, or 0 to disable)",
            "default": 0
          }
        },
        "type": "object",
        "title": "FaultConfigRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderRequest": {
        "properties": {
          "cart_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 3,
            "title": "Cart Id",
            "description": "Active cart ID to checkout"
          },
          "customer_email": {
            "type": "string",
            "title": "Customer Email",
            "description": "Customer contact email address"
          }
        },
        "type": "object",
        "required": [
          "cart_id",
          "customer_email"
        ],
        "title": "OrderRequest"
      },
      "UpdateOrderStatusRequest": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "cancelled",
              "fulfilled"
            ],
            "title": "Status",
            "description": "Target status ('cancelled' or 'fulfilled')"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "description": "Reason for status update",
            "default": "customer_request"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "UpdateOrderStatusRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}