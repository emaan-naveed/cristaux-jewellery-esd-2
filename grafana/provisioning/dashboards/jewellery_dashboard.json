  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "HTTP Request Latency (p95 & p99 Histogram)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency (s)"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99 Latency (s)"
        }
      ]
    },
    {
      "title": "Orders Placed Total (Counter)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(jewellery_orders_placed_total)",
          "legendFormat": "Total Orders"
        }
      ]
    },
    {
      "title": "Pending Orders Queue (Gauge)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "jewellery_pending_orders_count",
          "legendFormat": "Pending Orders"
        }
      ]
    },
    {
      "title": "Average Order Processing Time (Summary)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(jewellery_order_processing_seconds_sum[1m]) / rate(jewellery_order_processing_seconds_count[1m])",
          "legendFormat": "Avg Checkout Time (s)"
        }
      ]
    },
    {
      "title": "Host CPU Utilization - Node Exporter",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "CPU Usage %"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["observability", "jewellery"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "title": "Jewellery Store Observability Dashboard",
  "uid": "jewellery-obs-dashboard"
